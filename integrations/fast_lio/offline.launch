<launch>
  <param name="use_sim_time" value="true" />
  <rosparam command="load" file="/opt/fast_lio/config.yaml" />
  <param name="feature_extract_enable" value="false" />
  <param name="point_filter_num" value="1" />
  <param name="max_iteration" value="3" />
  <param name="filter_size_surf" value="0.2" />
  <param name="filter_size_map" value="0.3" />
  <param name="cube_side_length" value="1000.0" />
  <param name="runtime_pos_log_enable" value="false" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping"
        output="screen" required="true" />
</launch>
